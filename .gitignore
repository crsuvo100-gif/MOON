# Git ignore patterns for MOON project
# Runtime data that should never be committed

# moonscope runtime state
data/lock_state.json
logs/

# terminal_moon runtime state  
terminal_moon/data/lock_state.json
terminal_moon/logs/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual envs
.venv/
venv/
env/

# Secrets
.env
.env.*
