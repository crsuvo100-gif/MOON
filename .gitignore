# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual envs
.venv/
venv/
env/

# Secrets / local config (never commit)
.env
.env.*
!.env.example

# Runtime logs & state
app/logs/*.log
app/logs/long_term.jsonl
app/logs/lessons.jsonl
app/logs/episodes.json
app/logs/moon_lock.txt
app/logs/agent.log.*
app/logs/agent_brains/

# Capability system runtime registry (written at runtime; source is committed, not state)
capabilities/registry.json
capabilities/manifests/
capabilities/installed/
capabilities/cache/

# Global Connector runtime connection registry (permission-gated; written at runtime)
connections/registry.json

# Voice engine runtime: cloned-voice samples + registry (user audio, written at runtime)
voices/

# Test caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# OS / editor
.DS_Store
*.swp

# Auto-generated on-demand tools (built at runtime)
plugins/generated/
Telegram/

# Optional local skills corpus (not shipped; index_skills handles absence)
skills/
