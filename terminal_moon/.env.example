# MOON Terminal — .env example
# Copy to .env and fill in your values.

# ── LLM / model ──────────────────────────────────────────────
# Default local Ollama endpoint
MODEL_BASE_URL=http://127.0.0.1:11434/v1
MODEL_NAME=qwen2.5:1.5b
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=2048
MODEL_TIMEOUT=120.0

# Strong model for accuracy-critical tasks (optional)
STRONG_MODEL_NAME=
STRONG_MODEL_BASE_URL=

# ── fallback APIs (set key to enable) ────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=microsoft/DialoGPT-medium

# ── terminal auth ────────────────────────────────────────────
# Leave empty for local-only (safest). Set for remote access.
TERMINAL_ACCESS_TOKEN=

# ── embedding / semantic search ──────────────────────────────
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ── feature flags ────────────────────────────────────────────
ENABLE_BROWSER_AUTOMATION=false
ENABLE_OCR=false
ENABLE_PDF=false
ENABLE_AGENT_VALIDATION=false
ENABLE_AUTO_LEARNING=true
ENABLE_FAST_PATH=true
ENABLE_SELF_CONSISTENCY=true
SELF_CONSISTENCY_SAMPLES=2
TOOL_TIMEOUT=30.0
MAX_PARALLEL_AGENTS=4
ALLOW_DANGEROUS_TOOLS=true

# ── runtime ──────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8777
AUTOSTART=true
AUTO_VOICE=true
IDLE_SPEED=0.5
LOG_LEVEL=INFO
LOG_DIR=logs
APP_NAME=moontm
ENVIRONMENT=development

# ── voice unlock ─────────────────────────────────────────────
# Override the TUI unlock phrase (default: MOON love you 3000)
MOON_TUI_UNLOCK=MOON love you 3000

# ── terminal token (env override) ────────────────────────────
# MOON_TERMINAL_TOKEN=  (set in env, not here)
