# MOON local environment (copy of .env.example with your values).
# This file is gitignored -- never commit secrets.

# Local OpenAI-compatible model endpoint (e.g. Ollama / Mew / LM Studio).
MODEL_BASE_URL=http://127.0.0.1:11434/v1
MODEL_NAME=qwen3:0.6b
MODEL_API_KEY=not-required-for-local

# Embeddings (leave EMBEDDING_BASE_URL empty to use the deterministic offline
# fallback that needs no network).
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Toggles
ENABLE_AGENT_VALIDATION=true
ENABLE_AUTO_LEARNING=true

# Optional tool integrations (MOON ships with these UNLOCKED by default).
ENABLE_BROWSER_AUTOMATION=true
ENABLE_OCR=true
ENABLE_PDF=true

# Cyber ops: comma-separated hosts/CIDRs MOON may actively scan/exploit (your own assets).
AUTHORIZED_TARGETS=127.0.0.1,localhost,192.168.0.0/16,10.0.0.0/8

# Optional STRONG model for accuracy-critical/factual/cyber tasks + the main-brain gate.
# Unlocked to a larger local model (qwen3:1.7b) on this host for better accuracy.
# Set to an even larger model (e.g. an 8B+ you can run, or a remote endpoint you
# operate) for best accuracy; leave blank to use MODEL_NAME for everything.
STRONG_MODEL_NAME=qwen3:1.7b
STRONG_MODEL_BASE_URL=

# Connected GitHub repo MOON pulls tools/assets from on demand (public read OK, no token).
# Unlocked to her own repo so autonomous capability/tool acquisition is wired.
GITHUB_REPO=https://github.com/crsuvo100-gif/MOON

# --- OpenAI-compatible FALLBACK backend ---------------------------------
# Used ONLY when the local model endpoint (Ollama) is unavailable or a completion
# fails. Leave OPENAI_API_KEY blank for local-only operation. Paste your key here
# (this file is gitignored -- never commit the real key).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- OpenRouter FALLBACK backend (secondary) ----------------------------
# Tried after local and OpenAI. OpenRouter is OpenAI-compatible and lets MOON use
# many models (incl. Claude, Llama, etc.). Leave blank to disable.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Hugging Face FALLBACK backend (tertiary) ---------------------------
# Tried after local, OpenAI, and OpenRouter. HF's router speaks the
# OpenAI-compatible /v1/chat/completions shape. Leave blank to disable.
HUGGINGFACE_API_KEY=
HUGGINGFACE_BASE_URL=https://router.huggingface.co
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct

# --- Hugging Face OAuth client + Inference Endpoint namespace ------------
# MOON can register as an HF OAuth app (Authorization Code + PKCE). Fill your
# hosted URL below; the client payload is built from it. Leave blank for none.
HF_OAUTH_WEBSITE=
HF_OAUTH_CLIENT_NAME=MOON
HF_OAUTH_LOGO_URI=
# Namespace (org/user) under which MOON deploys HF Inference Endpoints.
HF_ENDPOINT_NAMESPACE=crsuvo

# --- OpenRouter ACCOUNT keys (NOT for model serving) ---------------------
# Management key: account/billing/admin only (create keys, view usage). NEVER send
# this to the chat endpoint. Webhook secret: verifies inbound OpenRouter webhooks
# (none wired yet). Both optional; keep blank unless you use those features.
OPENROUTER_MANAGEMENT_KEY=
OPENROUTER_WEBHOOK_SECRET=

# --- Telegram channel (MOON as a Telegram bot) -----------------------------
# Create a bot via @BotFather to get TELEGRAM_BOT_TOKEN; TELEGRAM_CHAT_ID is the
# numeric id of the chat MOON may reply in (blank = accept any chat). Both secret;
# stay in this gitignored .env, never committed. Run: python main.py telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_POLL_TIMEOUT=30

# --- Terminal remote-access authorization gate -----------------------------
# When set, MOON's Terminal WebSocket + /status require `Authorization: Bearer <token>`.
# Leave blank to keep MOON local-only (no auth needed). `moon_launcher.py tunnel`
# generates a token automatically for safe remote exposure.
MOON_TERMINAL_TOKEN=
