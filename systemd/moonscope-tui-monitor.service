[Unit]
Description=MOON moonscope TUI 모니터링 서비스 (주기 10초)
After=network.target

[Service]
Type=simple
ExecStart=/home/meow/Projects/MOON/.venv/bin/python /home/meow/Projects/MOON/moonscope_tui_monitor.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
WorkingDirectory=/home/meow/Projects/MOON

[Install]
WantedBy=default.target
