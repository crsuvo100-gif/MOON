[Unit]
Description=MOON moonscope 백엔드(8777) 모니터링 서비스 (대체)
Documentation=file:///home/meow/Projects/MOON/README.md
After=network-online.target moon-terminal.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/meow/Projects/MOON/.venv/bin/python /home/meow/Projects/MOON/moonscope_monitor.py
Restart=on-failure
RestartSec=10
WorkingDirectory=/home/meow/Projects/MOON
StandardOutput=journal
StandardError=journal
SyslogIdentifier=moonscope-monitor
Environment=PYTHONPATH=/home/meow/Projects/MOON
Environment=MOON_HOME=/home/meow/Projects/MOON

[Install]
WantedBy=default.target
