[Unit]
Description=MOON moonscope TUI 세션 + 백엔드 + LLM 모니터링 서비스 (대체)
Documentation=file:///home/meow/Projects/MOON/README.md
After=network-online.target moon-terminal.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/meow/Projects/MOON/.venv/bin/python /home/meow/Projects/MOON/moonscope_tui_monitor.py
Restart=on-failure
RestartSec=10
WorkingDirectory=/home/meow/Projects/MOON
StandardOutput=journal
StandardError=journal
SyslogIdentifier=moonscope-tui-monitor
Environment=PYTHONPATH=/home/meow/Projects/MOON
Environment=MOON_HOME=/home/meow/Projects/MOON
Environment=MODEL_NAME=qwen2.5:1.5b
Environment=MODEL_BASE_URL=http://127.0.0.1:11434/v1

[Install]
WantedBy=default.target
