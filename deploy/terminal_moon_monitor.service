[Unit]
Description=MOON terminal_moon TUI 모니터 서비스
Documentation=file:///home/meow/Projects/MOON/DEPLOY.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/meow/Projects/MOON/terminal_moon_monitor.sh
Restart=on-failure
RestartSec=10
WorkingDirectory=/home/meow/Projects/MOON
StandardOutput=journal
StandardError=journal
SyslogIdentifier=terminal-moon-monitor
Environment=MOON_HOME=/home/meow/Projects/MOON
Environment=MOON_TUI_UNLOCK=MOON love you 3000

[Install]
WantedBy=default.target
